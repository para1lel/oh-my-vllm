{
  "version": "deepseek-unquantized-projection-numerics-v1",
  "policy_sha256": "117e4a6976faf7595b9f96793bdee021a63e31da50f9b0c785aebd4955fa7c0a",
  "precision_policy": {
    "version": "deepseek-unquantized-projection-policy-proposal-v1",
    "scope": "Isolated unquantized matrix products, including block-diagonal grouped wo_a. No normalization, bias, routing selection, pooling, activation quantization, collectives, sampling, performance, or model-composition acceptance.",
    "contracts": {
      "bf16_bf16": "Exact BF16 inputs and prepared BF16 weights; FP32 accumulation and one final BF16 RN-even result. No activation quantization.",
      "bf16_f32": "Exact BF16 inputs and BF16 gate weights; FP32 results directly. The released Gate.forward widens operands to FP32. Never round logits to BF16 before post-logit routing.",
      "f32_f32": "FP32 inputs and FP32 weights, FP32 results. Real compressor/head/confidence weights are exact widenings of original BF16. Keep the current promoted storage, without a second narrowed persistent copy.",
      "wo_a": "Y[r,g,n]=sum_k X[r,g,k]*W[g,n,k]. G=2 for TP4/TEP4 and G=8 for DEP4. Input is physically [rows,G,4096], output [rows,G,1024]. Group views have row strides G*4096 and G*1024 elements, not packed row strides.",
      "reference": "CPU Torch FP64 matrix multiplication of exact boundary operand values. Store complete unrounded FP64 outputs, including every group, expert logit, and vocabulary entry. BF16/F32 casts are diagnostic outputs, not expected mathematical arrays.",
      "wo_a_promotion": "Use the already accepted startup-promotion code/scale lookup table, bound by its NPZ SHA, to obtain BF16 bits from original E4M3 and dense32 UE8M0. Do not use candidate promote_fp8 or assume original FP64 dequantization is the prepared BF16 value.",
      "finite_scope": "Fixed finite, bounded-amplitude operands; reject nonfinite source values and promotion overflow. This proposal does not accept arbitrary finite operands whose dot products overflow. No NaN saturation or subnormal flushing.",
      "head_partition": "Store one complete global-vocabulary row. Checker may view its four contiguous 32320-entry slices for TP4/TEP4 or the full 129280 entries for DEP4; no extra golden or collective acceptance.",
      "no_new_embedding_gate": "Embedding/gather and encoded Engram wkv are outside this unquantized gate."
    },
    "precision": {
      "u16": 0.00390625,
      "u32": 5.960464477539063e-08,
      "bf16_normalized_l2": 0.0078125,
      "f32_normalized_l2": 1.52587890625e-05,
      "absolute_formula_bf16": "max(1e-7, 2*u16*P + 64*u32*A)",
      "absolute_formula_f32": "max(1e-7, 256*u32*P + 64*u32*A)",
      "definitions": "For each stored output field and request: P=max(abs(Y64)); S[r,n]=sum_k abs(X64[r,k]*W64[n,k]); A=max(S). For grouped wo_a compute budgets and comparisons separately for every request and group.",
      "rms_floor": 1e-06,
      "near_zero_max_abs": 1e-06,
      "absolute_floor": 1e-07,
      "rationale": "Two BF16 unit roundoffs allow final RN-even rounding and engineering headroom. The separate FP32 normalized cap is 256*u32; 64*u32 times the absolute-product sum accounts for cancellation in the absolute cap. These fixed engineering caps are not a worst-case K-term reduction proof or borrowed Qwen limits.",
      "conditions": "Both normalized L2 and maximum absolute checks must pass. Zero/tiny requests are separate; larger requests cannot dilute them. Exact selected-zero and dyadic-bit guards are additional requirements, not relaxed by conditioning.",
      "independence": "These formulas precede generation and candidate code. Freeze realized P/A budgets with the FP64 fixtures, before native work. If an independent CPU source-precision diagnostic fails, record the failure and stop for policy review; never widen limits against a candidate."
    },
    "inputs": {
      "construction": "BF16 code palette in fixed order: [0x0000,0x8000,0x3a80,0xba80,0x3e00,0xbe00,0x3f00,0xbf00,0x3f80,0xbf80,0x4000,0xc000]. Normal input[r,g,k] uses palette[((k%97)+7*r+23*g)%12], multiplied by the exact power2^(-(request%4)). Use g=0 for dense inputs and row order within each request; real F32 inputs widen these BF16 values exactly. Zero/tiny/cancellation overrides have the declared case scope.",
      "zero_tiny": "Only the multi-request cases explicitly marked zero/tiny use request0 identically zero and request1 normal-pattern times2^-20. Single-row grouped and head cases use nonzero normal patterns. Keep request comparisons independent.",
      "real_cancellation": "In a fixed selected real output row, find the first lexicographic pair of nonzero equal BF16/promoted-BF16 weight values. Put opposite dyadic inputs at those columns, all other columns zero. Store column IDs, exact zero coordinate and full real-weight output. Add a second row with a tiny third contribution. If a pair is absent, stop; do not alter weights, seeds, or limits silently.",
      "g2_groups": "Construct each group independently. A zero guard for one group is never inferred for the other group.",
      "row0": "Use empty slices of each frozen input and preallocated empty outputs in the future checker. No new zero-row golden, checkpoint generation, or generic Case-catalog change."
    }
  },
