  "checkpoint_manifest_sha256": "0f42736d2943ec4725cb33d9e860a10ed994ba1d33e50d79c191847d3facea67",
  "generator_sha256": "2a45b62df608d296b0bd1fe873cd68c955c351dc8953e4d65c624115cd138f66",
  "precision_policy": {
    "scope": "Isolated post-projection Engram normalization, signed-square-root gate, token mask and residual blend. No lookup, hash, quantization, projection, state, collectives, latency or full-model acceptance.",
    "contract": {
      "rows": [
        0,
        384
      ],
      "copies": 4,
      "width": 5120,
      "epsilon": 1e-20,
      "clamp": 1e-06,
      "inputs": "BF16 residual[rows,4,5120], projected[rows,5,5120], q_weight/k_weight[4,5120], uint8 token mask[rows] in {0,1}. Projected first4 copies are keys and last copy is shared value. Fixed finite bounded operands. No implicit extra BF16 product rounding.",
      "formula": "Each copy: w=q_weight*k_weight; h2=mean(h*h); k2=mean(key*key); dot=sum(h*w*key)*rsqrt(h2+eps)*rsqrt(k2+eps)/sqrt(5120); gate=sigmoid(copysign(sqrt(max(abs(dot),1e-6)),dot)); mask0 sets gate0; output=h+gate*value. FP32 arithmetic, gate FP32 and final output BF16.",
      "reference": "Complete CPU Torch FP64 gate and residual output from exact BF16 operands. Check residual equivalence against unchanged reference_model.engram with injected fixed embedding/projection inputs."
    },
    "precision": {
      "u16": 0.00390625,
      "u32": 5.960464477539063e-08,
      "gate_normalized_l2": 6.103515625e-05,
      "gate_max_abs": 3.0517578125e-05,
      "output_normalized_l2": 0.0078125,
      "absolute_floor": 1e-07,
      "rms_floor": 1e-06,
      "near_zero_max_abs": 1e-06,
      "output_max_abs": "Per request max(1e-7,2*u16*max(abs(output64))+gate_max_abs*max(abs(projected_value))).",
      "guard": "Exact masked gate zeros; for masked rows positive finite residual values are unchanged. Exact zero-value residual passthrough where arithmetic has positive zero.",
      "limits_policy": "Engineering limits frozen before candidate, not worst-case proofs. Never widen limits or replace expected data against candidate results."
    },
    "inputs": {
      "seed": 33377335,
      "rule": "Deterministic BF16 dyadic patterns. Copy amplitudes 2**(copy-2), independent key phase and per-row sign. One quarter of rows masked; include zero residual, zero key, positive/negative correlated keys, orthogonal cancellation, tiny +/- dots and saturated gates. Synthetic decision case uses exact power-of-two weights; real cases use both original Engram q/k parameter pairs.",
      "residual_key_value_abs_max": 32,
      "weight_abs_max": 32
    }
  },
